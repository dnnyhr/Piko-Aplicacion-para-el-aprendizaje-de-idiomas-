{
  // Lo que corre en Node: el simulador, el validador de paquetes, el
  // transporte de pruebas y la suite de vitest. Nada de esto entra al APK.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "noEmit": true
  },
  "include": ["tools/**/*.ts", "tests/**/*.ts", "src/**/*.ts", "vitest.config.mts"],
  "exclude": ["node_modules", "**/*.tsx"]
}
