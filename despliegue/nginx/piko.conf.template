# Piko en Azure. Nginx es lo único que da a internet: el sitio sale de web/
# (montado de solo lectura) y la API se reenvía al contenedor "api", que no
# tiene ningún puerto abierto hacia afuera.
#
# Es una plantilla: al arrancar, la imagen de Nginx reemplaza ${DOMINIO_WEB} y
# ${DOMINIO_API} con lo que diga despliegue/.env. Las variables propias de
# Nginx ($host, $uri, …) no se tocan.

server_tokens off;

# ── Compresión: el JS de la app baja a la cuarta parte ──
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types text/plain text/css text/javascript application/javascript application/json
           application/manifest+json image/svg+xml font/ttf application/x-font-ttf;

# ── Límite de peticiones a la API: 10 por segundo por IP, con ráfagas de 20 ──
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

# ── HTTP: solo para Let's Encrypt; todo lo demás va a HTTPS ──
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Cualquier nombre que no sea el nuestro (escaneos por IP): se corta ──
server {
    listen 443 ssl default_server;
    http2 on;
    include /etc/nginx/snippets/tls.conf;
    return 444;
}

# ── El sitio y la app web: ${DOMINIO_WEB} ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO_WEB};
    include /etc/nginx/snippets/tls.conf;

    root /srv/web;
    index index.html;

    # Páginas de error amigables, sin códigos a la vista (web/404.html y web/50x.html).
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /404.html { internal; }
    location = /50x.html { internal; }

    # Las herramientas del sitio no son páginas.
    location /herramientas/ { return 404; }

    # La app del navegador: sus archivos llevan una huella en el nombre y
    # nunca cambian, así que el navegador los guarda un año (como en netlify.toml).
    location /probar/app/_expo/ {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /probar/app/assets/ {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    # Las rutas de la app (app/app/*.tsx) abren la app; cualquier otra cosa
    # es la página 404 del sitio, no la pantalla en inglés de Expo.
    # Si se agrega una pantalla nueva a la app, va también acá.
    location ~ ^/probar/app/(arbol|perfil|practicar|maestro|estudiante/(jugar|unirse)|logros(/canjear)?|minijuegos(/(chibolas|gallinita|rayuela|trompo))?|musica(/[\w-]+)?)/?$ {
        try_files /probar/app/index.html =404;
    }
    location /probar/app/ {
        try_files $uri $uri/ =404;
    }

    # El commit de main que está corriendo (lo escribe actualizar.sh).
    location = /version.json {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /site.webmanifest {
        default_type application/manifest+json;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# ── La API y las encuestas: ${DOMINIO_API} → contenedor api ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO_API};
    include /etc/nginx/snippets/tls.conf;

    # Igual que CUERPO_MAX del Worker (64 KB) con margen.
    client_max_body_size 128k;

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://api:8787;
        include /etc/nginx/snippets/proxy.conf;
        # Si la API no responde o se pide demasiado, igual sale JSON con un
        # mensaje para la persona, como los errores de la propia API.
        error_page 502 503 504 = @api_caida;
        error_page 429 = @api_espera;
    }
    location @api_caida {
        default_type application/json;
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":"El servicio no está disponible en este momento. Probá de nuevo en un rato."}';
    }
    location @api_espera {
        default_type application/json;
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Retry-After "10" always;
        return 429 '{"error":"Muchos pedidos seguidos. Esperá unos segundos y probá de nuevo."}';
    }
    location / {
        proxy_pass http://api:8787;
        include /etc/nginx/snippets/proxy.conf;
        # Si la API se cae, la página de "volvemos enseguida" del sitio.
        error_page 502 503 504 /50x.html;
    }
    location = /50x.html { root /srv/web; internal; }
    # Los estilos y el dibujo que usa esa página (encuestas no tiene /assets/).
    location /assets/ { root /srv/web; }
}
