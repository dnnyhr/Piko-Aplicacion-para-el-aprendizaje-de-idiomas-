# Piko en Azure. Nginx es lo único que da a internet: el sitio sale de web/
# (montado de solo lectura) y la API se reenvía al contenedor "api", que no
# tiene ningún puerto abierto hacia afuera.
#
# Es una plantilla: al arrancar, la imagen de Nginx reemplaza ${DOMINIO_WEB} y
# ${DOMINIO_API} con lo que diga despliegue/.env. Las variables propias de
# Nginx ($host, $uri, …) no se tocan.

server_tokens off;

# ── Compresión: el JS de la app baja a la cuarta parte ──
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types text/plain text/css text/javascript application/javascript application/json
           application/manifest+json image/svg+xml font/ttf application/x-font-ttf;

# ── Límite de peticiones a la API: 10 por segundo por IP, con ráfagas de 20 ──
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

# ── HTTP: solo para Let's Encrypt; todo lo demás va a HTTPS ──
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Cualquier nombre que no sea el nuestro (escaneos por IP): se corta ──
server {
    listen 443 ssl default_server;
    http2 on;
    include /etc/nginx/snippets/tls.conf;
    return 444;
}

# ── El sitio y la app web: ${DOMINIO_WEB} ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO_WEB};
    include /etc/nginx/snippets/tls.conf;

    root /srv/web;
    index index.html;

    # Las herramientas del sitio no son páginas.
    location /herramientas/ { return 404; }

    # La app del navegador: sus archivos llevan una huella en el nombre y
    # nunca cambian, así que el navegador los guarda un año (como en netlify.toml).
    location /probar/app/_expo/ {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /probar/app/assets/ {
        include /etc/nginx/snippets/cabeceras.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    # Cualquier ruta de la app (/probar/app/practicar, …) abre la app.
    location /probar/app/ {
        try_files $uri $uri/ /probar/app/index.html;
    }

    location = /site.webmanifest {
        default_type application/manifest+json;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# ── La API y las encuestas: ${DOMINIO_API} → contenedor api ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO_API};
    include /etc/nginx/snippets/tls.conf;

    # Igual que CUERPO_MAX del Worker (64 KB) con margen.
    client_max_body_size 128k;

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://api:8787;
        include /etc/nginx/snippets/proxy.conf;
    }
    location / {
        proxy_pass http://api:8787;
        include /etc/nginx/snippets/proxy.conf;
    }
}
