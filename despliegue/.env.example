# Copiar a despliegue/.env en el servidor y completar. despliegue/.env NUNCA va
# a git (.gitignore lo ignora) y en el servidor queda con chmod 600.

# ── Dominios (registros A en Cloudflare, con la nube gris: "DNS only") ──
DOMINIO_WEB=azure.piko.mugiware.com
DOMINIO_API=api.piko.mugiware.com

# ── CORS: quién puede pedir /api/publico/* desde el navegador ──
# Exactamente los orígenes, separados por coma. Nunca "*".
CORS_ORIGINS=https://piko.mugiware.com,https://azure.piko.mugiware.com

# ── Secretos ──
# Para publicar encuestas y entrar al panel. Mínimo 16 caracteres:
#   openssl rand -hex 24
ADMIN_TOKEN=
# Con qué se firman los JWT del panel (sesiones de 8 horas). Mínimo 32
# caracteres: openssl rand -hex 32. Si queda vacío, se deriva de ADMIN_TOKEN.
JWT_SECRET=
# Opcional: sin esto los correos quedan como "omitido".
RESEND_API_KEY=

# ── Variables (las mismas de wrangler.jsonc) ──
ENCUESTA_PRINCIPAL=que-le-falta-a-piko
CORREO_REMITENTE=Piko <piko@mugiware.com>
APP_DESCARGA_URL=https://github.com/dnnyhr/Piko-Aplicacion-para-el-aprendizaje-de-idiomas-/releases/latest/download/piko.apk
CORREO_RESPUESTA=
